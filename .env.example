BACKEND_BASE_URL=http://127.0.0.1:8082
BACKEND_SERVICE_EMAIL=prediction-service-admin@example.test
BACKEND_SERVICE_PASSWORD=replace-with-local-secret

CLUSTER_UPDATE_HOURS=24
